# Sentry Configuration
# Get your DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
# This is PUBLIC and safe to expose in client code
PUBLIC_SENTRY_DSN=https://example@o000000.ingest.sentry.io/0000000

# Sentry Organization slug (required — source map uploads 403 without it)
# Find it in your Sentry URL: https://sentry.io/organizations/[org]/
SENTRY_ORG=your-org-slug

# Sentry Auth Token (for source map uploads during build)
# Must be an Organization Auth Token (not a legacy project-scoped token):
# https://docs.sentry.io/product/accounts/auth-tokens/#organization-auth-tokens
# KEEP SECRET - Do not commit!
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Google Analytics 4 Measurement ID
# Find in: Google Analytics → Admin → Data Streams → Your Stream
# Format: G-XXXXXXXXXX
# This is PUBLIC and safe to expose in client code
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# Find in: Google Tag Manager → Admin → Container Settings
# Format: GTM-XXXXXXX
# This is PUBLIC and safe to expose in client code
PUBLIC_GTM_ID=GTM-XXXXXXX
