# Keep the build context small and, more importantly, keep host-built
# artifacts out of the image — node_modules built on arm64 macOS would
# defeat the purpose of testing on x86-64 Linux.
node_modules/
dist/
.astro/
coverage/
robot-results/
.venv-robot/
.git/
.history/
.netlify/
.opencode/
public/resume.pdf
public/slides/*.pdf
.env
.env.*
!.env.example
.DS_Store
