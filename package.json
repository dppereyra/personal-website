{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run full-build",
    "build:site": "astro check && astro build",
    "full-build": "npm test && npm run generate:resume && npm run generate:slides && npm run build:site",
    "preview": "astro preview",
    "preview:e2e": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:robot:install": "python3 -m venv .venv-robot && ./.venv-robot/bin/python -m pip install -r requirements-robot.txt",
    "test:robot": "robot --outputdir robot-results --exclude deployed-only tests/robot",
    "test:robot:chrome": "BROWSER=chrome npm run test:robot",
    "test:robot:firefox": "BROWSER=firefox npm run test:robot",
    "test:robot:all": "npm run test:robot:chrome && npm run test:robot:firefox",
    "test:robot:deployed": "robot --outputdir robot-results --include deployed-only tests/robot",
    "generate:resume": "node scripts/generate-resume-pdf.js",
    "generate:slides": "node scripts/generate-slide-pdfs.js"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/svelte": "9.0.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "svelte": "5.56.10",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@marp-team/marp-core": "^4.4.0",
    "@sentry/astro": "10.71.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "daisyui": "5.7.22",
    "happy-dom": "20.11.8",
    "jsdom": "30.0.1",
    "jsonresume-theme-even": "0.26.1",
    "jsonresume-theme-stackoverflow": "3.3.0",
    "puppeteer": "25.9.0",
    "resumed": "7.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "vite": "8.1.5",
    "rollup": "4.62.2"
  }
}
