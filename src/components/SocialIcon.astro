---
interface Props {
  network?: string;
  class?: string;
}

const { network = '', class: className = 'h-4 w-4' } = Astro.props;
const key = network.trim().toLowerCase();
const isGitHub = key === 'github';
const isLinkedIn = key === 'linkedin';
const isX = key === 'x' || key === 'twitter';
const isGitLab = key === 'gitlab';
const isPluralsight = key === 'pluralsight';
const isEmail = key === 'email' || key === 'mail';
const isKnown = isGitHub || isLinkedIn || isX || isGitLab || isPluralsight || isEmail;
---

{isGitHub && (
  <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
    <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
  </svg>
)}

{isLinkedIn && (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
    <rect x="3" y="9" width="3.2" height="11" fill="currentColor" />
    <circle cx="4.6" cy="5.2" r="2" fill="currentColor" />
    <path d="M10.5 9h3.1v1.6h.05c.43-.8 1.5-1.65 3.1-1.65 3.3 0 3.95 2.06 3.95 4.75V20H17.5v-5.4c0-1.29-.03-2.94-1.8-2.94-1.8 0-2.08 1.4-2.08 2.85V20H10.5Z" fill="currentColor" />
  </svg>
)}

{isX && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
    <path d="M5 5l14 14M19 5L5 19" />
  </svg>
)}

{isGitLab && (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" opacity="0.14" />
    <text x="12" y="16" text-anchor="middle" font-size="9" font-weight="700" fill="currentColor" font-family="system-ui, sans-serif">GL</text>
  </svg>
)}

{isPluralsight && (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
    <rect width="24" height="24" rx="6" fill="currentColor" opacity="0.14" />
    <text x="12" y="17" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor" font-family="system-ui, sans-serif">P</text>
  </svg>
)}

{isEmail && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3 7l9 6 9-6" />
  </svg>
)}

{!isKnown && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3c2.5 2.7 3.8 6 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-6-3.8-9s1.3-6.3 3.8-9Z" />
  </svg>
)}
