---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, sortByDate } from '../../utils/formatDate';

const allPosts = await getCollection('blog');
const sortedPosts: CollectionEntry<'blog'>[] = sortByDate(allPosts);
---

<Layout title="Blog - Chiff's Nook">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-4xl font-bold">Blog</h1>
      <a href="/blog/rss.xml" class="btn btn-outline btn-sm">RSS</a>
    </div>

    <div class="space-y-6">
      {sortedPosts.map((post) => (
        <article class="card bg-base-200 shadow-xl relative">
          <div class="card-body">
            <h2 class="card-title text-2xl">
              <a href={`/blog/${post.id}`} class="hover:text-primary after:absolute after:inset-0">
                {post.data.title}
              </a>
            </h2>
            <p class="text-base-content/70">
              {post.data.description}
            </p>
            <div class="flex items-center gap-4 text-sm text-base-content/60">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.tags.length > 0 && (
                <div class="flex gap-2">
                  {post.data.tags.map((tag: string) => (
                    <span class="badge badge-sm">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
