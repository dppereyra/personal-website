---
import Layout from '../layouts/Layout.astro';
import type { Resume } from '../types/resume';
import resumeData from '../resume.json';
import { formatMonthYear } from '../utils/formatDate';

const resume = resumeData as Resume;
const projects = resume.projects || [];

function formatDate(dateString?: string): string {
  if (!dateString) return 'Present';
  return formatMonthYear(dateString);
}

// Helper function to get project status
function getProjectStatus(endDate?: string): string {
  return endDate ? 'Completed' : 'Ongoing';
}
---

<Layout title="Projects - dppereyra" description="Portfolio of projects and contributions">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Projects</h1>

    {projects.length === 0 ? (
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>No projects available. Update resume.json to add your projects.</span>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <article class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow">
            <div class="card-body">
              <div class="flex items-start justify-between mb-2">
                <h2 class="card-title text-xl">
                  {project.url ? (
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="link link-primary hover:link-secondary">
                      {project.name}
                    </a>
                  ) : (
                    project.name
                  )}
                </h2>
                <div class="badge badge-primary badge-sm">
                  {getProjectStatus(project.endDate)}
                </div>
              </div>

              {project.type && (
                <div class="text-xs text-base-content/60 mb-2">
                  {project.type.charAt(0).toUpperCase() + project.type.slice(1)}
                </div>
              )}

              {project.description && (
                <p class="text-base-content/80 mb-4">{project.description}</p>
              )}

              {project.roles && project.roles.length > 0 && (
                <div class="mb-3">
                  <div class="text-sm font-semibold mb-1">Role:</div>
                  <div class="flex flex-wrap gap-1">
                    {project.roles.map((role) => (
                      <span class="badge badge-outline badge-sm">{role}</span>
                    ))}
                  </div>
                </div>
              )}

              {project.highlights && project.highlights.length > 0 && (
                <div class="mb-3">
                  <div class="text-sm font-semibold mb-1">Highlights:</div>
                  <ul class="list-disc list-inside text-sm space-y-1">
                    {project.highlights.map((highlight) => (
                      <li class="text-base-content/70">{highlight}</li>
                    ))}
                  </ul>
                </div>
              )}

              {project.keywords && project.keywords.length > 0 && (
                <div>
                  <div class="text-sm font-semibold mb-2">Technologies:</div>
                  <div class="flex flex-wrap gap-2">
                    {project.keywords.map((keyword) => (
                      <span class="badge badge-sm">{keyword}</span>
                    ))}
                  </div>
                </div>
              )}

              {(project.startDate || project.entity) && (
                <div class="text-xs text-base-content/60 mt-4 pt-4 border-t border-base-300">
                  {project.startDate && (
                    <div>{formatDate(project.startDate)} - {formatDate(project.endDate)}</div>
                  )}
                  {project.entity && <div>Organization: {project.entity}</div>}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-8">
      <a href="/" class="btn btn-ghost">← Back to Home</a>
    </div>
  </div>
</Layout>
