---
import Layout from '../layouts/Layout.astro';
import type { Resume } from '../types/resume';
import resumeData from '../resume.json';
import SocialIcon from '../components/SocialIcon.astro';
import { CALENDLY_MEETING_URL } from '../consts';

const resume = resumeData as Resume;
const basics = resume.basics || {};
---

<Layout title="Contact - Chiff's Nook" description="Get in touch with me">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Contact Me</h1>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-4">Get in Touch</h2>

          <div id="contact-success" class="alert alert-success mb-4" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Thanks for reaching out! Your message has been sent.</span>
          </div>

          <div id="contact-error" class="alert alert-error mb-4" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"></path>
            </svg>
            <span>Something went wrong sending your message. Please try again or email me directly below.</span>
          </div>

          <form id="contact-form" class="space-y-4" method="POST" action="/" name="contact" data-netlify="true" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Don&apos;t fill this out if you&apos;re human: <input name="bot-field" />
              </label>
            </p>
            <div class="form-control">
              <label class="label" for="name">
                <span class="label-text">Name</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label" for="email">
                <span class="label-text">Email</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="your.email@example.com"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label" for="message">
                <span class="label-text">Message</span>
              </label>
              <textarea
                id="message"
                name="message"
                placeholder="Your message"
                class="textarea textarea-bordered h-32"
                required
              ></textarea>
            </div>

              <button type="submit" class="btn btn-primary w-full">
                Send Message
              </button>
              <p class="text-sm text-base-content/70">
                Messages submitted here are captured by Netlify form handling.
              </p>
           </form>
        </div>
      </div>

      <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-2xl mb-4">Other Ways to Connect</h2>

          <div class="space-y-4">
            <div>
              <h3 class="font-semibold mb-2">Meetings</h3>
              <p class="text-base-content/70">
                Prefer to talk it through? Book a 30-minute slot on my calendar:
              </p>
              <a
                href={CALENDLY_MEETING_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary mt-2"
              >
                Schedule a Meeting
              </a>
            </div>

            {basics.email && (
            <div>
              <h3 class="font-semibold mb-2">Email</h3>
              <p class="text-base-content/70">
                Rather not book a slot? Send a message straight to my inbox:
              </p>
              <a href={`mailto:${basics.email}`} class="btn btn-outline mt-2 gap-2">
                <SocialIcon network="email" class="h-4 w-4 shrink-0" />
                Email me instead
              </a>
            </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="alert alert-info mt-8">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>Messages can be submitted directly here, or you can book a meeting or email me directly.</span>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  const successEl = document.getElementById('contact-success');
  const errorEl = document.getElementById('contact-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitButton?.setAttribute('disabled', 'true');
    errorEl?.setAttribute('hidden', 'true');

    const data = new FormData(form);

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
      });

      if (!response.ok) {
        throw new Error(`Request failed with status ${response.status}`);
      }

      form.hidden = true;
      successEl?.removeAttribute('hidden');
    } catch (err) {
      errorEl?.removeAttribute('hidden');
      submitButton?.removeAttribute('disabled');
    }
  });
</script>
