---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate } from '../../utils/formatDate';
import { renderSlides } from '../../utils/marp';

export async function getStaticPaths() {
  const decks = await getCollection('slides');
  return decks.map((deck: CollectionEntry<'slides'>) => ({
    params: { slug: deck.id },
    props: deck,
  }));
}

const deck: CollectionEntry<'slides'> = Astro.props;

// Read the raw markdown (frontmatter included) directly from disk rather than
// via the content collection's `.body`, which has the frontmatter already
// stripped by Astro's loader. Marp's own front-matter parser needs to see
// `theme:`/`paginate:` etc. directly in the text passed to it.
const rawMarkdownPath = join(process.cwd(), 'src/content/slides', `${deck.id}.md`);
const rawMarkdown = readFileSync(rawMarkdownPath, 'utf-8');
const { html, css } = renderSlides(rawMarkdown);
---

<Layout title={deck.data.title} description={deck.data.description}>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8">
      <a href="/slides" class="btn btn-ghost btn-sm mb-4">← Back to Slides</a>
      <h1 class="text-4xl font-bold mb-4">{deck.data.title}</h1>
      <div class="flex items-center gap-4 text-sm text-base-content/60">
        <time datetime={deck.data.pubDate.toISOString()}>
          {formatDate(deck.data.pubDate)}
        </time>
        {deck.data.tags.length > 0 && (
          <div class="flex gap-2">
            {deck.data.tags.map((tag: string) => (
              <span class="badge badge-sm">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <style set:html={css} />
    <div class="marpit" set:html={html} />
  </article>
</Layout>
