---
import Layout from '../layouts/Layout.astro';
import type { Resume } from '../types/resume';
import resumeData from '../resume.json';
import { formatMonthYear, parseDateValue } from '../utils/formatDate';

const resume = resumeData as Resume;
const workHistory = resume.work || [];

function formatDate(dateString?: string): string {
  if (!dateString) return 'Present';
  return formatMonthYear(dateString);
}

function calculateDuration(startDate?: string, endDate?: string): string {
  if (!startDate) return '';

  const start = parseDateValue(startDate);
  const end = endDate ? parseDateValue(endDate) : new Date();

  const months = (end.getUTCFullYear() - start.getUTCFullYear()) * 12 +
                 (end.getUTCMonth() - start.getUTCMonth());
  const years = Math.floor(months / 12);
  const remainingMonths = months % 12;

  const parts = [];
  if (years > 0) parts.push(`${years} ${years === 1 ? 'year' : 'years'}`);
  if (remainingMonths > 0) parts.push(`${remainingMonths} ${remainingMonths === 1 ? 'month' : 'months'}`);

  return parts.join(', ');
}
---

<Layout title="Work History - dppereyra" description="Professional work experience and career history">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Work History</h1>

    {workHistory.length === 0 ? (
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>No work history available. Update resume.json to add your work experience.</span>
      </div>
    ) : (
      <div class="space-y-8">
        {workHistory.map((job) => (
          <article class="card bg-base-200 shadow-xl">
            <div class="card-body">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
                <div>
                  <h2 class="card-title text-2xl">
                    {job.position}
                  </h2>
                  <div class="text-lg font-semibold text-primary">
                    {job.url ? (
                      <a href={job.url} target="_blank" rel="noopener noreferrer" class="link link-primary">
                        {job.name}
                      </a>
                    ) : (
                      job.name
                    )}
                  </div>
                </div>
                <div class="text-sm text-base-content/70 md:text-right">
                  <div>{formatDate(job.startDate)} - {formatDate(job.endDate)}</div>
                  <div class="font-medium">{calculateDuration(job.startDate, job.endDate)}</div>
                  {job.location && <div class="mt-1">{job.location}</div>}
                </div>
              </div>

              {job.summary && (
                <p class="text-base-content/80 mb-4">{job.summary}</p>
              )}

              {job.highlights && job.highlights.length > 0 && (
                <div>
                  <h3 class="font-semibold mb-2">Key Achievements:</h3>
                  <ul class="list-disc list-inside space-y-1">
                    {job.highlights.map((highlight) => (
                      <li class="text-base-content/80">{highlight}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-8">
      <a href="/" class="btn btn-ghost">← Back to Home</a>
    </div>
  </div>
</Layout>
